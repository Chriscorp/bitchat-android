# Environment variables template for Celer Android Fastlane configuration
# Copy this file to .env and fill in the values, or set as GitHub Secrets

# Keystore configuration
# KEYSTORE_PASSWORD=your_keystore_password_here
# KEY_ALIAS=celer-key
# KEY_PASSWORD=your_key_password_here

# Google Play Service Account JSON (path to the file or base64-encoded content)
# GOOGLE_PLAY_JSON_PATH=google-play-service-account.json

# Build configuration
# PACKAGE_NAME=com.chriscorp.celer
